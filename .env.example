# EchoService reads its settings from the Echo database — table
# `echo_tbl_Settings`, rows where `sApp` is '*' (every Echo app) or 'service'
# (this one). See EchoDatabase `init/009_settings.sql`.
#
# This file carries only what cannot describe itself: how to reach that
# database, and how to reach the NocoDB base that carries the platform's
# `trustedCIDR`.

PORT=8080

# ── The Echo database ────────────────────────────────────────────────────────
# Where echo_tbl_Settings lives. A database cannot carry its own address, so
# these stay here. No defaults: a wrong host that looks configured is worse
# than one that is plainly missing.
DB_HOST=echo-database
DB_PORT=3306
DB_USER=echo_app
DB_PASSWORD=
DB_NAME=echo_db

# ── The trusted network ──────────────────────────────────────────────────────
# `trustedCIDR` is platform-wide network policy that identity and every
# application have to agree on, so it is spelled once — in the NocoDB base
# `IdentityBase`, table `auth_tbl_Settings` — rather than copied into each
# app's own settings. Callers from inside it reach the webhook endpoints
# without basic auth; Bandwidth, which is outside it, still presents
# credentials. The base is found by NAME at runtime, never by an ID.
NOCODB_BASE_URL=http://nocodb:8080
NOCODB_API_TOKEN=generate-in-nocodb-ui
# Pin it here instead and NocoDB is not consulted for it at all.
# IDENTITY_TRUSTED_NETWORK=10.9.0.0/16

# ── Optional: pin a setting here ─────────────────────────────────────────────
# Any echo_tbl_Settings key may also be set here, where it OVERRIDES the row.
#
# CORS_ORIGINS=
# WEBHOOK_BASIC_USER=
# WEBHOOK_BASIC_PASS=
# MEDIA_ROOT=/media
# BANDWIDTH_ACCOUNT_ID=
# BANDWIDTH_API_TOKEN=
# BANDWIDTH_API_SECRET=
# BANDWIDTH_APPLICATION_ID=
# BANDWIDTH_MESSAGING_API_BASE_URL=
