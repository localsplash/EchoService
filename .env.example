# Export for npm start; Compose only forwards declared environment variables.
# Normal source: PlatformConfig/cfg_tbl_Setting, scopes * < echo < echo-service.
NOCODB_BASE_URL=http://nocodb:8080
NOCODB_API_TOKEN=

# Application database pool coordinates remain deployment bootstrap.
DB_HOST=echo-database
DB_PORT=3306
DB_USER=echo_service
DB_PASSWORD=
DB_NAME=echo_db

# Listener and shared media mount require restart to change.
PORT=8080
MEDIA_ROOT=/media

# Optional deployment network overrides.
# With a reverse proxy in front (carrier webhook ingress), keep TRUSTED_PROXIES
# at the loopback default so X-Forwarded-For is ignored and a public request can
# never be taken for a trusted one. IDENTITY_TRUSTED_NETWORK overrides the
# PlatformConfig trustedCIDR row and should normally stay unset.
# TRUSTED_PROXIES=127.0.0.1/32
# IDENTITY_TRUSTED_NETWORK=10.9.0.0/16

# ─── compose.yaml: what the environment supplies ──────────────────────────────
# Names of Docker objects this environment already has. compose.yaml is meant to
# be `include:`d by the environment's own Compose file; compose.dev.yaml is the
# throwaway local instance instead.
ECHO_NETWORK=echo-net
ECHO_MEDIA_VOLUME=echo-media-data
ECHO_SERVICE_LOGS_VOLUME=echo-service-logs
# ECHO_SERVICE_TAG=dev
# ECHO_SERVICE_CONTAINER_NAME=echo-service

# Carrier webhook ingress: also join the reverse-proxy network. Leave this
# COMPOSE_FILE line out in an environment no carrier delivers to.
COMPOSE_FILE=compose.yaml:compose.proxy.yaml
# ECHO_PROXY_NETWORK=npm_network

# Runtime settings are NOT listed here. CORS_ORIGINS, WEBHOOK_BASIC_USER,
# WEBHOOK_BASIC_PASS and the BANDWIDTH_* keys come only from PlatformConfig
# cfg_tbl_Setting; a same-named variable here is ignored. Two homes for one
# credential meant a rotation in the store could silently not take effect.
