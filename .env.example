# EchoService reads its settings from NocoDB, not from this file: the base
# `IdentityBase` (one base per repository, named `{Repo}Base`), table
# `auth_tbl_Settings`. See localsplash/identity#15 for the standard.
#
# The base is found by NAME at runtime, never by a base ID in a file: a
# pasted ID survives a rename and outlives a restore. The name is expected to
# be unique — NocoDB does not enforce that, we do.
#
# If the base cannot be found, this service retries once at startup and then
# exits saying so. There is no fallback to defaults.

PORT=8080

# ── The settings store (NocoDB at nocodb.X.TLD) ──────────────────────────────
NOCODB_BASE_URL=http://nocodb:8080
NOCODB_API_TOKEN=generate-in-nocodb-ui

# ── Optional: pin a setting here ─────────────────────────────────────────────
# Any key below may also be set here, where it OVERRIDES the stored row —
# an override for deployments that manage configuration as environment, not a
# default. Blank counts as unset.
#
# The trusted network — ONE value for the whole platform, the `trustedCIDR`
# row. Callers from inside it reach the webhook endpoints without basic auth;
# Bandwidth, which is outside it, still presents credentials.
# IDENTITY_TRUSTED_NETWORK=10.9.0.0/16
#
# DB_HOST=
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# CORS_ORIGINS=
# WEBHOOK_BASIC_USER=
# WEBHOOK_BASIC_PASS=
# MEDIA_ROOT=/media
# BANDWIDTH_ACCOUNT_ID=
# BANDWIDTH_API_TOKEN=
# BANDWIDTH_API_SECRET=
# BANDWIDTH_APPLICATION_ID=
# BANDWIDTH_MESSAGING_API_BASE_URL=
